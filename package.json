{
  "name": "py-linkedin-jobs-scraper",
  "version": "1.0.0",
  "description": "This is a simple example package. You can use [Github-flavored Markdown](https://guides.github.com/features/mastering-markdown/) to write your content.",
  "main": "index.js",
  "scripts": {
    "hooks": "git config core.hooksPath .githooks",
    "clean": "rm -fr build dist *.egg-info __pycache__ **/__pycache__ .pytest_cache",
    "build": "npm run clean && uv build",
    "deploy": "uv publish --publish-url https://test.pypi.org/legacy/",
    "test": "uv run pytest tests/unit --capture=no --log-cli-level=DEBUG",
    "test:e2e:programmatic": "uv run pytest tests/test_programmatic.py --capture=no --log-cli-level=DEBUG",
    "test:e2e:cli": "uv run pytest tests/test_cli.py --capture=no --log-cli-level=DEBUG",
    "test:e2e": "uv run pytest tests/test_programmatic.py tests/test_cli.py --capture=no --log-cli-level=DEBUG"
  },
  "author": "",
  "license": "MIT"
}
